#defaultView:Map
# Science / exploration / engineering milestones -- God's Eye View
# Three disjoint branches, each independently cheap. ~2,100 rows.
SELECT ?item ?itemLabel ?itemDescription ?kind ?when ?coord ?fame WHERE {
  {
    # A. Dated discoveries pinned to a REAL find spot.
    #    P189 (location of discovery) ONLY -- never wdt:P625/P276, which for a
    #    museum object is the display case (Boscoreale Treasure -> Louvre Room 662).
    SELECT ?item ("discovery" AS ?kind) (MIN(?date) AS ?when)
           (SAMPLE(?co) AS ?coord) (MAX(?s) AS ?fame) WHERE {
      ?item wdt:P575 ?date ; wikibase:sitelinks ?s ; wdt:P189 ?pl .
      ?pl wdt:P625 ?co .
      FILTER(?s >= 3)
      FILTER(isLiteral(?date))  # WDQS skolemizes "unknown value" to a genid IRI, so isBlank() does NOT catch it
      # reject country / continent / state centroids: not "it happened HERE"
      FILTER NOT EXISTS { ?pl wdt:P31/wdt:P279* wd:Q10864048 }
      FILTER NOT EXISTS {
        VALUES ?bad { wd:Q6256 wd:Q3624078 wd:Q112099 wd:Q20181813 wd:Q5107 wd:Q82794 }
        ?pl wdt:P31 ?bad
      }
    } GROUP BY ?item
  } UNION {
    # B. Nuclear weapons tests. NO fame filter -- these are bot-imported and
    #    sitelinks>=3 would cut 1152 down to 16.
    SELECT ?item ("nuclear test" AS ?kind) (MIN(?date) AS ?when)
           (SAMPLE(?co) AS ?coord) (MAX(?s) AS ?fame) WHERE {
      ?item wdt:P31 wd:Q210112 ; wdt:P585 ?date ; wdt:P625 ?co ; wikibase:sitelinks ?s .
      FILTER(isLiteral(?date))
    } GROUP BY ?item
  } UNION {
    # C. Astronomical observatories, dated by inception (P571, not P585).
    SELECT ?item ("observatory" AS ?kind) (MIN(?date) AS ?when)
           (SAMPLE(?co) AS ?coord) (MAX(?s) AS ?fame) WHERE {
      ?item wdt:P31 wd:Q1254933 ; wdt:P571 ?date ; wdt:P625 ?co ; wikibase:sitelinks ?s .
      FILTER(isLiteral(?date))
      FILTER(?s >= 8)
    } GROUP BY ?item
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
